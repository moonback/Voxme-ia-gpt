{
  "name": "voxme",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "cd backend && cargo run",
    "build": "npm --workspace frontend run build",
    "typecheck": "npm --workspace frontend run typecheck",
    "install:frontend": "npm --workspace frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
